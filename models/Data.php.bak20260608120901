	function save_agregat_puskesmas(){
		$p = $this->post;
		// Validasi field wajib
		$required = ['id_puskesmas','id_petugas_puskesmas','year','time_unit_value','detail'];
		foreach($required as $f){
			if(!isset($p[$f]) || $p[$f]==='' || $p[$f]===null){
				return ['status'=>false,'keterangan'=>'Field '.$f.' wajib diisi','kode'=>400];
			}
		}
		// Validasi detail harus array
		if(!is_array($p['detail']) || count($p['detail'])==0){
			return ['status'=>false,'keterangan'=>'Field detail harus berupa array penyakit','kode'=>400];
		}
		// Validasi total kunjungan (id_penyakit=22) tidak boleh 0
		foreach($p['detail'] as $d){
			if(intval($d['id_penyakit'])==22 && intval($d['nilai'])<=0){
				return ['status'=>false,'keterangan'=>'Total Kunjungan (id_penyakit=22) harus diisi dan tidak boleh 0','kode'=>400];
			}
		}
		// Validasi minggu tidak boleh > minggu aktif
		// Ambil minggu aktif dari tabel ewarn_minggu
		$row_minggu = $this->db->select('week, week_year')->where('week_date >=', date('Y-m-d'))->order_by('week_date','asc')->limit(1)->get('ewarn_minggu')->row_array();
		if(!$row_minggu){
			$row_minggu = $this->db->select('week, week_year')->where('week_date <', date('Y-m-d'))->order_by('week_date','desc')->limit(1)->get('ewarn_minggu')->row_array();
		}
		$minggu_aktif = $row_minggu ? intval($row_minggu['week']) : intval(date('W'));
		$tahun_aktif  = $row_minggu ? intval($row_minggu['week_year']) : intval(date('Y'));
		$tahun_aktif  = intval(date('Y'));
		$minggu_input = intval($p['time_unit_value']);
		$tahun_input  = intval($p['year']);
		if($tahun_input > $tahun_aktif || ($tahun_input == $tahun_aktif && $minggu_input > $minggu_aktif)){
			return ['status'=>false,'keterangan'=>'Minggu '.$minggu_input.'/'.$tahun_input.' melebihi minggu aktif '.$minggu_aktif.'/'.$tahun_aktif,'kode'=>400];
		}
		// Cek duplikat
		$cek = $this->db->where('time_unit_value',$p['time_unit_value'])->where('year',$p['year'])->where('id_puskesmas',$p['id_puskesmas'])->get('ewarn_datareport')->row_array();
		if($cek){
			return ['status'=>false,'keterangan'=>'Data minggu '.$p['time_unit_value'].'/'.$p['year'].' sudah pernah dientry','kode'=>409,'id'=>$cek['id']];
		}
		// Hitung sts_tepat
		$kirim = date('w');
		$sts_tepat = ($minggu_input == $minggu_aktif && intval($kirim)<=2) ? 1 : 0;
		// Insert header
		$header = [
			'id_puskesmas'       => intval($p['id_puskesmas']),
			'id_petugas_puskesmas'=> $p['id_petugas_puskesmas'],
			'id_unit'            => isset($p['id_unit']) ? intval($p['id_unit']) : 0,
			'year'               => $tahun_input,
			'time_unit'          => 1,
			'time_unit_value'    => $minggu_input,
			'time_unit_date'     => date('Y-m-d H:i:s'),
			'form_date'          => isset($p['form_date']) ? $p['form_date'] : date('Y-m-d'),
			'data_entry_date'    => date('Y-m-d H:i:s'),
			'sts_simpan'         => 7,
			'sts_tepat'          => $sts_tepat,
			'create_date'        => date('Y-m-d H:i:s'),
			'create_user'        => isset($p['create_user']) ? $p['create_user'] : 'api',
			'petugas_entry'      => isset($p['create_user']) ? $p['create_user'] : 'api',
		];
		$this->db->insert('ewarn_datareport', $header);
		$id = $this->db->insert_id();
		if(!$id) return ['status'=>false,'keterangan'=>'Gagal menyimpan header laporan','kode'=>500];
		// Load alert library
		$this->load->library('alert');
		// Insert detail per penyakit
		$detail_saved = 0;
		foreach($p['detail'] as $d){
			$id_penyakit = intval($d['id_penyakit']);
			$nilai = isset($d['nilai']) ? intval($d['nilai']) : 0;
			$kematian = isset($d['kematian']) ? intval($d['kematian']) : 0;
			$lab = isset($d['lab']) ? intval($d['lab']) : 0;
			// Generate alert
			$alert = $this->alert->set_data(['id_puskesmas'=>intval($p['id_puskesmas']),'kasus'=>$nilai,'id_penyakit'=>$id_penyakit,'id_minggu'=>$minggu_input,'id_tahun'=>$tahun_input])->generate_alert()->draw();
			$detail = [
				'id_datareport' => $id,
				'id_penyakit'   => $id_penyakit,
				'nilai'         => $nilai,
				'jml_kematian'  => $kematian,
				'lab'           => $lab,
				'create_date'   => date('Y-m-d H:i:s'),
				'create_user'   => isset($p['create_user']) ? $p['create_user'] : 'api',
			];
			if(isset($alert[$id_penyakit]) && $alert[$id_penyakit]['sts_alert']){
				$detail['sts_alert'] = $alert[$id_penyakit]['sts_alert'];
				$detail['kasus']     = $alert[$id_penyakit]['kasus'];
				$detail['ambang']    = $alert[$id_penyakit]['ambang'];
				$detail['criteria']  = $alert[$id_penyakit]['criteria'];
				$detail['bandingkan']= $alert[$id_penyakit]['bandingkan'];
			}
			$this->db->insert('ewarn_datareport_detail', $detail);
			$detail_saved++;
		}
		return [
			'status'     => true,
			'kode'       => 200,
			'keterangan' => 'Data agregat berhasil disimpan',
			'id'         => $id,
			'sts_tepat'  => $sts_tepat,
			'detail_saved'=> $detail_saved,
			'minggu'     => $minggu_input,
			'tahun'      => $tahun_input,
		];
	}

